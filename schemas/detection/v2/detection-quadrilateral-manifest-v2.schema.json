{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anpr-engine.vibesofters.com/schemas/detection/v2/detection-quadrilateral-manifest-v2.schema.json",
  "title": "DetectionQuadrilateralManifestV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "content_sha256", "samples"],
  "properties": {
    "schema_version": {"const": "detection-quadrilateral-manifest-v2"},
    "dataset_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sample_id",
          "split",
          "atomic_group_id",
          "canonical_image_path",
          "canonical_annotation_path"
        ],
        "properties": {
          "sample_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "split": {"type": "string", "enum": ["train", "validation", "test"]},
          "atomic_group_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "canonical_image_path": {"type": "string", "minLength": 1},
          "canonical_annotation_path": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
