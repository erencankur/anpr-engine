{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anpr-engine.vibesofters.com/schemas/internal/v2/anpr-private-inference-response-v2.schema.json",
  "title": "AnprPrivateInferenceResponseV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "admission_id", "status", "prediction", "prediction_source", "decoding_changed_raw", "structural_validity", "informational_confidence", "detection", "rectification", "models", "crop_policy", "timings_ms", "error_code"],
  "properties": {
    "schema_version": {"const": "anpr-private-inference-response-v2"},
    "request_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$", "maxLength": 26},
    "admission_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{32,64}$", "maxLength": 64},
    "status": {"type": "string", "enum": ["prediction_available", "recognition_unresolved", "no_plate_detected", "multiple_detections", "geometry_unresolved"]},
    "prediction": {"type": ["string", "null"], "pattern": "^[0-9A-Z ]{1,16}$", "maxLength": 16},
    "prediction_source": {"const": "existing_project_decoder"},
    "decoding_changed_raw": {"type": "boolean"},
    "structural_validity": {"type": "string", "enum": ["valid", "invalid", "not_run"]},
    "informational_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_count", "selection_rule", "boundary_state", "quadrilateral_xy_normalized", "box_xyxy_normalized", "informational_confidence", "rejected_geometry_reasons"],
      "properties": {
        "candidate_count": {"type": "integer", "minimum": 0},
        "selection_rule": {"const": "highest_confidence_valid_quadrilateral_then_box_coordinates"},
        "boundary_state": {"type": "string", "enum": ["valid", "unresolved", "not_found"]},
        "quadrilateral_xy_normalized": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/NormalizedQuadrilateralV2"}]},
        "box_xyxy_normalized": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}}]},
        "informational_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "rejected_geometry_reasons": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/GeometryRejectionReasonV2"}}
      }
    },
    "rectification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "method", "output_width", "output_height"],
      "properties": {
        "state": {"type": "string", "enum": ["applied", "not_run", "rejected"]},
        "method": {"oneOf": [{"const": "PROJECTIVE_QUADRILATERAL_V2"}, {"type": "null"}]},
        "output_width": {"type": ["integer", "null"], "minimum": 1},
        "output_height": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detection", "recognition"],
      "properties": {
        "detection": {"$ref": "#/$defs/QuadrilateralDetectionModelIdentityV2"},
        "recognition": {"$ref": "#/$defs/QuadrilateralRecognitionModelIdentityV2"}
      }
    },
    "crop_policy": {"const": "DETECTOR_QUADRILATERAL_V2_STRICT"},
    "timings_ms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "validation", "detection", "rectification", "recognition"],
      "properties": {
        "total": {"type": "number", "minimum": 0, "maximum": 120000},
        "validation": {"type": "number", "minimum": 0, "maximum": 120000},
        "detection": {"type": "number", "minimum": 0, "maximum": 120000},
        "rectification": {"type": "number", "minimum": 0, "maximum": 120000},
        "recognition": {"type": "number", "minimum": 0, "maximum": 120000}
      }
    },
    "error_code": {"type": ["string", "null"], "enum": [null, "NO_PLATE_DETECTED", "MULTIPLE_DETECTIONS_VALID_QUAD_SELECTED", "UNRESOLVED_GEOMETRY", "RECOGNITION_UNRESOLVED", "STRUCTURAL_VALIDATION_FAILED"]}
  },
  "$defs": {
    "NormalizedPointV2": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}},
    "NormalizedQuadrilateralV2": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/NormalizedPointV2"}},
    "GeometryRejectionReasonV2": {"type": "string", "enum": ["NON_FINITE", "OUT_OF_BOUNDS", "WRONG_ORDER_OR_DEGENERATE", "NON_CONVEX_OR_SELF_INTERSECTING", "AREA_TOO_SMALL", "EDGE_TOO_SHORT", "EXCESSIVE_PERSPECTIVE", "HOMOGRAPHY_UNSTABLE", "OUTPUT_SIZE_INVALID"]},
    "QuadrilateralDetectionModelIdentityV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "model_id", "sha256"],
      "properties": {
        "architecture": {"const": "yolox_multiscale_quad_v2"},
        "model_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "QuadrilateralRecognitionModelIdentityV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "sha256"],
      "properties": {
        "model_id": {"const": "m3-v4-stroke-20260914"},
        "sha256": {"const": "25b6e4af757b87da75162293a28274e3a0ecbb7f29bc55489b7132e353ad5ff7"}
      }
    }
  }
}
