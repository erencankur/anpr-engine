{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anpr-engine.vibesofters.com/schemas/internal/v1/anpr-private-inference-response-v1.schema.json",
  "title": "AnprPrivateInferenceResponseV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "admission_id",
    "status",
    "prediction",
    "prediction_source",
    "decoding_changed_raw",
    "structural_validity",
    "informational_confidence",
    "detection",
    "models",
    "crop_policy",
    "timings_ms",
    "error_code"
  ],
  "properties": {
    "schema_version": {
      "const": "anpr-private-inference-response-v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "maxLength": 26
    },
    "admission_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{32,64}$",
      "maxLength": 64
    },
    "status": {
      "type": "string",
      "enum": [
        "prediction_available",
        "recognition_unresolved",
        "no_plate_detected",
        "multiple_detections",
        "crop_refinement_failed"
      ]
    },
    "prediction": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9A-Z ]{1,16}$",
      "maxLength": 16
    },
    "prediction_source": {
      "enum": [
        "existing_project_decoder",
        "paddleocr"
      ]
    },
    "decoding_changed_raw": {
      "type": "boolean"
    },
    "structural_validity": {
      "type": "string",
      "enum": [
        "valid",
        "invalid",
        "not_run"
      ]
    },
    "informational_confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_count",
        "selection_rule",
        "box_xyxy_normalized",
        "informational_confidence"
      ],
      "properties": {
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "selection_rule": {
          "const": "highest_confidence_then_box_coordinates"
        },
        "box_xyxy_normalized": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          ]
        },
        "informational_confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detection",
        "recognition"
      ],
      "properties": {
        "detection": {
          "$ref": "#/$defs/DetectionModelIdentity"
        },
        "recognition": {
          "$ref": "#/$defs/RecognitionModelIdentity"
        }
      }
    },
    "crop_policy": {
      "enum": [
        "BLUE_BAND_GLYPH_QUAD_V1",
        "HYPERLPR_FOUR_CORNERS_V1"
      ]
    },
    "timings_ms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "validation",
        "detection",
        "crop_refinement",
        "recognition"
      ],
      "properties": {
        "total": {
          "type": "number",
          "minimum": 0,
          "maximum": 120000
        },
        "validation": {
          "type": "number",
          "minimum": 0,
          "maximum": 120000
        },
        "detection": {
          "type": "number",
          "minimum": 0,
          "maximum": 120000
        },
        "crop_refinement": {
          "type": "number",
          "minimum": 0,
          "maximum": 120000
        },
        "recognition": {
          "type": "number",
          "minimum": 0,
          "maximum": 120000
        }
      }
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "NO_PLATE_DETECTED",
        "MULTIPLE_DETECTIONS_TOP1_SELECTED",
        "CROP_REFINEMENT_FAILED",
        "RECOGNITION_UNRESOLVED",
        "STRUCTURAL_VALIDATION_FAILED"
      ]
    },
    "plate_geometry": {
      "$ref": "#/$defs/PlateGeometryV1"
    },
    "plate_crops": {
      "$ref": "#/$defs/PlateCropPreviewsV1"
    },
    "candidate_prediction": {
      "type": "string",
      "pattern": "^[0-9A-Z ]{1,16}$",
      "maxLength": 16
    }
  },
  "$defs": {
    "DetectionModelIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "sha256"
      ],
      "properties": {
        "model_id": {
          "enum": [
            "detection-v3-20260827",
            "hyperlpr-y5fu-320-corners-v1",
            "hyperlpr-y5fu-640-corners-v1"
          ]
        },
        "sha256": {
          "enum": [
            "0d5e9b52fae5638e0ef1badafdeb53fe0771d056e43c4953d13cceed520e71ea",
            "2a985dc63a5cc947ec36d18503d6fc0fd54525b9dba17f2fe29a71e86b44456d",
            "0306de937471b87f56eb3f5620815e7e7058f8ab7428e0734fc64627cc4d716c"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "model_id": {
                "const": "detection-v3-20260827"
              }
            }
          },
          "then": {
            "properties": {
              "sha256": {
                "const": "0d5e9b52fae5638e0ef1badafdeb53fe0771d056e43c4953d13cceed520e71ea"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "model_id": {
                "const": "hyperlpr-y5fu-320-corners-v1"
              }
            }
          },
          "then": {
            "properties": {
              "sha256": {
                "const": "2a985dc63a5cc947ec36d18503d6fc0fd54525b9dba17f2fe29a71e86b44456d"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "model_id": {
                "const": "hyperlpr-y5fu-640-corners-v1"
              }
            }
          },
          "then": {
            "properties": {
              "sha256": {
                "const": "0306de937471b87f56eb3f5620815e7e7058f8ab7428e0734fc64627cc4d716c"
              }
            }
          }
        }
      ]
    },
    "RecognitionModelIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "sha256"
      ],
      "properties": {
        "model_id": {
          "enum": [
            "m3-v4-stroke-20260914",
            "paddleocr-latin-finetuned-v1"
          ]
        },
        "sha256": {
          "enum": [
            "25b6e4af757b87da75162293a28274e3a0ecbb7f29bc55489b7132e353ad5ff7",
            "5fffa451df2efa707bafd3d1da7e94aaebf83c5d365d2c4b8a6d439b4ac48964"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "model_id": {
                "const": "m3-v4-stroke-20260914"
              }
            }
          },
          "then": {
            "properties": {
              "sha256": {
                "const": "25b6e4af757b87da75162293a28274e3a0ecbb7f29bc55489b7132e353ad5ff7"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "model_id": {
                "const": "paddleocr-latin-finetuned-v1"
              }
            }
          },
          "then": {
            "properties": {
              "sha256": {
                "const": "5fffa451df2efa707bafd3d1da7e94aaebf83c5d365d2c4b8a6d439b4ac48964"
              }
            }
          }
        }
      ]
    },
    "PlateGeometryV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "method",
        "quadrilateral_xy_normalized",
        "rectification_applied"
      ],
      "properties": {
        "state": {
          "enum": [
            "estimated",
            "unresolved",
            "not_run"
          ]
        },
        "method": {
          "enum": [
            "PLATE_FACE_CONTOUR_V1",
            null,
            "HYPERLPR_FOUR_CORNERS_V1"
          ]
        },
        "quadrilateral_xy_normalized": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          ]
        },
        "rectification_applied": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "estimated"
              }
            }
          },
          "then": {
            "properties": {
              "method": {
                "enum": [
                  "PLATE_FACE_CONTOUR_V1",
                  "HYPERLPR_FOUR_CORNERS_V1"
                ]
              },
              "quadrilateral_xy_normalized": {
                "type": "array"
              },
              "rectification_applied": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "method": {
                "type": "null"
              },
              "quadrilateral_xy_normalized": {
                "type": "null"
              },
              "rectification_applied": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "PlateCropPreviewV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_type",
        "encoded_data",
        "width",
        "height",
        "metadata_removed"
      ],
      "properties": {
        "media_type": {
          "const": "image/jpeg"
        },
        "encoded_data": {
          "type": "string",
          "contentEncoding": "base64",
          "minLength": 8,
          "maxLength": 16000,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 640
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 192
        },
        "metadata_removed": {
          "const": true
        }
      }
    },
    "PlateCropPreviewsV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rectified",
        "recognition_input"
      ],
      "properties": {
        "rectified": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/PlateCropPreviewV1"
            }
          ]
        },
        "recognition_input": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/PlateCropPreviewV1"
            }
          ]
        }
      }
    }
  }
}
